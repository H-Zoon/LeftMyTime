<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#F7F4EF">
    <TextView android:id="@+id/probe_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/widget_seconds_probe_name"
        android:textColor="#211E1B" android:textSize="16sp" />
    <Chronometer android:id="@+id/probe_clock" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="30sp" android:textColor="#211E1B" />
    <TextView android:id="@+id/probe_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#211E1B" android:textSize="14sp" />
</LinearLayout>
