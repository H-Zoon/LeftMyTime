<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/gray600</item>
        <item name="colorPrimaryVariant">@color/gray400</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/activity_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Customize your theme here. -->
        <item name="android:fontFamily">@font/nanum_square_round_r</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:timePickerStyle">@style/MyTimePickerDialogStyle</item>
        <item name="android:windowBackground">@color/activity_background</item>
    </style>

    <style name="Theme.MyApplication.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_foreground</item>
        <item name="windowSplashScreenAnimationDuration">760</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ThemeOverlay.MyApplication.AppWidgetContainer" parent="">
        <item name="colorPrimary">@color/black</item>
        <item name="android:backgroundTint">#CCFFFFFF</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/nanum_square_round_r</item>
    </style>

    <style name="MyTimePickerDialogStyle" parent="android:Widget.Material.Light.TimePicker">
        <item name="android:timePickerMode">spinner</item>
        <item name="android:padding">40dp</item>
    </style>

</resources>
