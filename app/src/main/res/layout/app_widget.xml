<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/line_widget"
    android:orientation="vertical"
    android:padding="14dp"
    android:theme="@style/ThemeOverlay.MyApplication.AppWidgetContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/nanum_square_round_b"
            android:maxLines="1"
            android:textColor="@color/widget_primary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_icon_button"
            android:contentDescription="@string/widget_refresh"
            android:padding="7dp"
            android:scaleType="center"
            android:src="@drawable/ic_baseline_refresh_24"
            app:tint="@color/widget_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/percent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/nanum_square_round_eb"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_on_surface"
        android:textSize="24sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="7dp">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/progressbar_widget" />

        <ProgressBar
            android:id="@+id/progressEmerald"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/progressbar_widget_emerald"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressRose"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/progressbar_widget_rose"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressAmber"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/progressbar_widget_amber"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressSlate"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/progressbar_widget_slate"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
