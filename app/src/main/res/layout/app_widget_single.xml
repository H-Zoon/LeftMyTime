<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background_light" android:padding="@dimen/widget_padding" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/widget_gap" android:orientation="vertical">
            <TextView android:id="@+id/summary" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/widgetUpdatedAt" style="@style/WidgetText.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/widget_small_gap" android:visibility="gone" />
        </LinearLayout>
        <ImageButton android:id="@+id/refresh" android:layout_width="@dimen/widget_touch_target" android:layout_height="@dimen/widget_touch_target"
            android:background="@android:color/transparent" android:padding="12dp" android:src="@drawable/ic_baseline_refresh_24"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/percent" style="@style/WidgetText.Value" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap" />
    <TextView android:id="@+id/widgetMeta" style="@style/WidgetText.Label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap" />
    <ImageView android:id="@+id/widgetRuler" android:layout_width="match_parent" android:layout_height="@dimen/widget_ruler_height"
        android:layout_marginTop="@dimen/widget_gap" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widgetRange" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_small_gap" android:orientation="horizontal">
        <TextView android:id="@+id/widgetStart" style="@style/WidgetText.Label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <TextView android:id="@+id/widgetEnd" style="@style/WidgetText.Label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetLegacyFlow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_section_gap" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/widgetFlowToday" style="@style/WidgetText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/widgetFlowMonth" style="@style/WidgetText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/widget_gap" />
        <TextView android:id="@+id/widgetFlowYear" style="@style/WidgetText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/widget_gap" />
    </LinearLayout>
</LinearLayout>
