<?xml version="1.0" encoding="utf-8"?>
<!-- Picker/initial state only. Live values always come from the shared renderer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_picker_background" android:padding="16dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="sans" android:textSize="14sp" android:textColor="@color/widget_on_surface"
        android:text="@string/period_today" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="sans" android:textSize="32sp"
        android:textColor="@color/widget_on_surface" android:text="@string/widget_preview_placeholder" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="sans" android:textSize="12sp" android:textColor="@color/widget_on_surface_variant"
        android:text="@string/time_remaining" />
</LinearLayout>
