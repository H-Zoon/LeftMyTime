<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/line_widget"
    android:orientation="vertical"
    android:padding="14dp"
    android:theme="@style/ThemeOverlay.MyApplication.AppWidgetContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/nanum_square_round_b"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="@color/widget_primary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_icon_button"
            android:contentDescription="@string/widget_refresh"
            android:padding="7dp"
            android:scaleType="center"
            android:src="@drawable/ic_baseline_refresh_24"
            app:tint="@color/widget_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            layout="@layout/widget_progress_ring_only"
            android:layout_width="64dp"
            android:layout_height="64dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nanum_square_round_eb"
                android:maxLines="1"
                android:text="@string/widget_preview_value"
                android:textColor="@color/widget_on_surface"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/widgetMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/nanum_square_round_r"
                android:maxLines="2"
                android:text="@string/widget_preview_meta"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
